+/**
+ * The new model — from the changeover date (settings, never hardwired).
+ *
+ * One rate, one owner, no form. Material = receipts sum + declared own
+ * material; both deducted from gross, both reimbursed on top when the rule
+ * says the subbie funds material. Compliance is a flag and a penalty, never
+ * a pre-baked rate.
+ */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { calculateJob, buildStatement, OUTCOME } from '../lib/commission.mjs';
+
+const CUTOFF = '2026-08-14';
+
+/** A contractor living on both sides of the changeover. */
+const alex = {
+  name: 'Alex Fitzpatrick',
+  sm8StaffUuid: 'uuid-alex',
+  rules: [
+    // Old world: 60/40 company-funded, the three-way split.
+    { from: '2025-01-01', rates: { quoted_and_completed: 40, completed_only: 30, quoted_only: 20 }, materialsFundedBy: 'company' },
+    // New world: rung 0 on the ladder, subbie-funded, one rate.
+    { from: CUTOFF, rates: { rate: 50 }, materialsFundedBy: 'subbie' },
+  ],
+};
+
+test('before the cutoff, no form still means not payable', () => {
+  const r = calculateJob({
+    job: { jobNumber: 'A', invoiceIncGst: 1000, date: '2026-08-13' },
+    forms: [], contractor: alex, cutoffDate: CUTOFF,
+  });
+  assert.equal(r.outcome, OUTCOME.AWAITING_FORM);
+});
+
+test('on the cutoff, no form is fine — completion is the trigger', () => {
+  const r = calculateJob({
+    job: { jobNumber: 'B', invoiceIncGst: 1000, date: CUTOFF, completedByUuid: 'uuid-alex' },
+    forms: [], contractor: alex, cutoffDate: CUTOFF,
+  });
+  assert.equal(r.outcome, OUTCOME.OK);
+  assert.equal(r.model, 'new');
+});
+
+test('no cutoff configured means the old model everywhere', () => {
+  const r = calculateJob({
+    job: { jobNumber: 'C', invoiceIncGst: 1000, date: '2026-09-01' },
+    forms: [], contractor: alex,
+  });
+  assert.equal(r.outcome, OUTCOME.AWAITING_FORM);
+});
+
+test('the money: deducted before the split, reimbursed after', () => {
+  // Invoice 1000, receipts 200, own material 50, rung 0 = 50%.
+  // gross 750 → share 375 → + 250 back = 625. Mr Sparky keeps 375 of the 750.
+  const r = calculateJob({
+    job: {
+      jobNumber: '168001', invoiceIncGst: 1000, date: '2026-08-20',
+      completedByUuid: 'uuid-alex', expenseIncGst: 200, ownMaterialIncGst: 50,
+    },
+    contractor: alex, cutoffDate: CUTOFF,
+  });
+  assert.equal(r.grossProfit, 750);
+  assert.equal(r.share, 375);
