+
+test('compliance failed drops the rate 2 points but keeps the rung', () => {
+  const r = calculateJob({
+    job: { jobNumber: 'F', invoiceIncGst: 1000, date: '2026-08-20', completedByUuid: 'uuid-alex' },
+    contractor: alex, cutoffDate: CUTOFF,
+    compliance: { failed: true, penaltyPoints: 2, note: 'compliance ran at 72%, needed 80%' },
+  });
