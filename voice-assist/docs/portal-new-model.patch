+/**
+ * Dress post-cutoff jobs in new-model figures, on CLONES — the job list is a
+ * shared cache and receipts are per-contractor, so mutating in place would
+ * leak one contractor's material figure into another's statement.
+ *
+ * Material under the new model: the sum of this job's payable receipts
+ * (voided excluded, credit notes negative, no photo = recorded but not paid)
+ * plus what the tech declared as own material with no receipt. The Job_Cost
+ * sheet still rules everything before the cutoff and is untouched here.
+ */
+function withNewModelFigures({ jobs, receiptRows, ownMaterialRows, cutoff }) {
+  if (!cutoff) return jobs;
+  const rByJob = receipts.byJob(receiptRows);
+  const matByJob = Object.fromEntries((ownMaterialRows || []).map((m) => [String(m.jobNumber), m]));
+  return jobs.map(({ job, forms }) => {
+    if (!job.date || job.date < cutoff) return { job, forms };
+    const evidenced = receipts.payableMaterialIncGst(rByJob[String(job.jobNumber)] || []);
+    const declared = Number(matByJob[String(job.jobNumber)]?.amountIncGst) || 0;
+    return {
+      forms,
+      job: {
+        ...job,
+        expenseIncGst: evidenced,
+        ownMaterialIncGst: declared,
+        // Receipts are live data, not a sheet someone may not have typed into
+        // yet — "unconfirmed" is an old-model concept.
+        expenseUnknown: false,
+        materialsUnconfirmed: false,
+      },
+    };
+  });
+}
