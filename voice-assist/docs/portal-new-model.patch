+test('missing completer falls back to trusting the assignment', () => {
+  const r = calculateJob({
+    job: { jobNumber: 'E', invoiceIncGst: 800, date: '2026-08-20' },
+    contractor: alex, cutoffDate: CUTOFF,
+  });
+  assert.equal(r.outcome, OUTCOME.OK);
