+async function moveReceiptTo(receiptId, fromJob){
+  const to=prompt('Move this receipt to which job number?','');
+  if(!to)return;
+  if(BUSY)return; BUSY=true;
+  try{
+    const r=await fetch('/api/receipts/move',{method:'POST',
+      headers:{Authorization:'Bearer '+token(),'content-type':'application/json'},
+      body:JSON.stringify({contractorId:(DATA.profile||{}).personId,fromJobNumber:fromJob,
+        receiptId:receiptId,toJobNumber:String(to).replace(/[^0-9]/g,'')})});
+    const out=await r.json();
+    if(!r.ok)throw new Error(out.error||'Could not move it');
+    DATA=null; await load();
+  }catch(e){ alert(e.message) }
+  finally{ BUSY=false }
+}
+
+async function voidReceipt(receiptId, jobNumber, on){
+  const voiding = on==='1';
+  /* A void takes money off what gets paid, so it says why, on the record. */
+  const why = voiding ? prompt('Why is this being voided?','') : '';
+  if(voiding && !why)return;
+  if(BUSY)return; BUSY=true;
+  try{
+    const r=await fetch('/api/receipts/void',{method:'POST',
+      headers:{Authorization:'Bearer '+token(),'content-type':'application/json'},
+      body:JSON.stringify({contractorId:(DATA.profile||{}).personId,jobNumber:jobNumber,
+        receiptId:receiptId,voided:voiding,reason:why})});
+    const out=await r.json();
+    if(!r.ok)throw new Error(out.error||'Could not do that');
+    DATA=null; await load();
+  }catch(e){ alert(e.message) }
+  finally{ BUSY=false }
+}
