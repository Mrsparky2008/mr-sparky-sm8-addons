@@ -0,0 +1,101 @@
+/**
+ * The 14 August changeover, as one reviewable settings write.
+ *
+ * What it does — all in settings, nothing in code:
+ *
+ *   1. Sets changeover.cutoffDate. This is THE switch: until it exists every
+ *      job calculates on the old model, whatever code is deployed.
+ *   2. Appends a new-model rule version to every network subbie, effective on
+ *      the cutoff: rung 0 (50%), one flat rate, materials funded by subbie.
+ *      Appends — never edits history, so pre-cutoff jobs keep their old rule.
+ *   3. Deletes Alex's stray rule of 2026-07-27 (70%, subbie-funded). Nobody
+ *      was on the new structure before the changeover; it should not exist.
+ *   4. Sets vanStock defaults ($50 cap, 5% review flag) if absent.
+ *   5. Sets retention to the agreed policy: 10% accrual to a $1,000 target.
+ *
+ * Dry run by default — prints the exact before/after and writes nothing.
+ *
+ *   node scripts/changeover-2026-08-14.mjs            # show what would change
+ *   node scripts/changeover-2026-08-14.mjs --apply    # write it, versioned
+ *
+ * The write goes through settings-store.save(), so the previous version is
+ * kept and the change carries a note — the same audit trail as a portal edit.
+ */
+import { loadStored, save } from '../lib/settings-store.mjs';
+
+const APPLY = process.argv.includes('--apply');
+const CUTOFF = process.env.CUTOFF_DATE || '2026-08-14';
+
+const settings = await loadStored();
+if (!settings) {
+  console.error('No stored settings — run against the live table (check AWS credentials/region).');
+  process.exit(1);
+}
+
+const changes = [];
+
+// 1. The switch.
+if (settings.changeover?.cutoffDate === CUTOFF) {
+  console.log(`changeover.cutoffDate already ${CUTOFF} — nothing to do there.`);
+} else {
+  changes.push(`changeover.cutoffDate: ${settings.changeover?.cutoffDate ?? '(unset)'} -> ${CUTOFF}`);
+  settings.changeover = { ...(settings.changeover || {}), cutoffDate: CUTOFF };
+}
+
+// 2. A new-model rule for every network subbie, effective on the cutoff.
+const NEW_RULE = { from: CUTOFF, type: 'fixed', rates: { rate: 50 }, materialsFundedBy: 'subbie',
+  note: 'Changeover: ladder rung 0, tech buys material, reimbursed on top.' };
+const subbies = (settings.people || []).filter((p) => p.role === 'Subbie');
+for (const p of subbies) {
+  const rules = settings.commissionRules[p.id] || [];
+  if (rules.some((r) => r.from === CUTOFF)) {
+    console.log(`${p.name}: already has a rule effective ${CUTOFF} — left alone.`);
+    continue;
+  }
+  changes.push(`${p.name} (${p.id}): append rule from ${CUTOFF} — rate 50, subbie-funded`);
+  settings.commissionRules[p.id] = [...rules, NEW_RULE];
+}
+
+// 3. Alex's stray rule. Match precisely — date AND shape — so this can never
+// delete a legitimate rule that happens to share the date.
+const alex = (settings.people || []).find((p) => /alex/i.test(p.name));
+if (alex) {
+  const rules = settings.commissionRules[alex.id] || [];
+  const stray = rules.filter((r) => r.from === '2026-07-27' && r.materialsFundedBy === 'subbie');
+  if (stray.length) {
+    changes.push(`${alex.name}: delete stray rule of 2026-07-27 (${JSON.stringify(stray[0].rates)})`);
+    settings.commissionRules[alex.id] = rules.filter((r) => !stray.includes(r));
+  } else {
+    console.log(`${alex.name}: no stray 2026-07-27 rule found — nothing to delete.`);
+  }
+}
+
+// 4. Van stock defaults, only where unset — a tuned value is never clobbered.
+if (settings.vanStock?.defaultCapIncGst == null) {
+  changes.push('vanStock: default cap $50, review flag 5% of invoice');
+  settings.vanStock = { defaultCapIncGst: 50, flagPercentOfInvoice: 5, byContractor: {}, ...(settings.vanStock || {}) };
+}
+
+// 5. Retention: 10% to $1,000, held whole, released 12 months after the later
+// of losing job access or the last completed job (the release itself is a
+// human act; the target is what the engine enforces).
+const target = Number(settings.retention?.default?.target) || 0;
+if (target !== 1000) {
+  changes.push(`retention.default.target: ${target} -> 1000 (accrual stays 10%)`);
+  settings.retention = { ...(settings.retention || {}),
+    default: { ...(settings.retention?.default || {}), target: 1000, accrualPercent: 10 } };
+}
+
+if (!changes.length) { console.log('\nEverything already in place. No write needed.'); process.exit(0); }
+
+console.log(`\n${APPLY ? 'APPLYING' : 'DRY RUN — would apply'}:\n  - ${changes.join('\n  - ')}`);
+
+if (APPLY) {
+  const { savedAt } = await save({
+    settings, by: 'changeover-script',
+    note: `14 August changeover: cutoff ${CUTOFF}, ladder rung 0 for all subbies, van stock cap, retention target $1,000.`,
+  });
+  console.log(`\nSaved (versioned) at ${savedAt}. The previous settings version is retained.`);
+} else {
+  console.log('\nNothing written. Re-run with --apply to make it real.');
+}
