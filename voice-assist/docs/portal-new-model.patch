index 0000000..85db241
--- /dev/null
+++ b/test/compliance.test.mjs
@@ -0,0 +1,69 @@
+/**
+ * Compliance: 2 points of the rung hang on the paperwork.
+ * Run: node --test test/compliance.test.mjs
+ */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { policyFor, formDoneKeys, jobComplies, complianceRate, complianceAssessment } from '../lib/compliance.mjs';
+
+const JSA = 'jsa-form-uuid';
+const policy = policyFor({ compliance: { jsaFormUuid: JSA, passPercent: 80, penaltyPoints: 2 } });
+
+const job = (n, date, uuid = `u-${n}`) => ({ jobNumber: String(n), uuid, date });
+
+test('formDoneKeys matches by related uuid and by Job Number answer, and fails safe', () => {
+  const done = formDoneKeys([
+    { form_uuid: JSA, active: '1', regarding_object_uuid: 'u-1' },
+    { form_uuid: JSA, active: '1', field_data: JSON.stringify([{ Question: 'Job Number', Response: '167595' }]) },
+    { form_uuid: JSA, active: '0', regarding_object_uuid: 'u-dead' },   // inactive never counts
+    { form_uuid: 'other-form', active: '1', regarding_object_uuid: 'u-2' },
+    { form_uuid: JSA, active: '1', field_data: 'not json' },            // unreadable — no crash, no match
+  ], JSA);
+  assert.equal(done.has('u-1'), true);
+  assert.equal(done.has('167595'), true);
+  assert.equal(done.has('u-dead'), false);
+  assert.equal(done.has('u-2'), false);
+});
+
+test('a job with no policy in force is unmeasured — never a free pass', () => {
+  const noPolicy = policyFor({});   // jsaFormUuid null → ships dark
+  assert.equal(jobComplies(job(1, '2026-08-20'), { policy: noPolicy, jsaDone: new Set() }), null);
+});
+
+test('the 80% window: 9 of 10 passes, 7 of 10 fails, nothing measured is null', () => {
+  const jobs = Array.from({ length: 10 }, (_, i) => job(i, '2026-08-20'));
+  const doneNine = new Set(jobs.slice(0, 9).map((j) => j.uuid));
+  const doneSeven = new Set(jobs.slice(0, 7).map((j) => j.uuid));
+
+  const nine = complianceRate({ jobs, policy, jsaDone: doneNine, cutoffDate: '2026-08-14' });
+  assert.equal(nine.percent, 90);
+  assert.equal(complianceAssessment({ rate: nine, policy }).failed, false);
+
+  const seven = complianceRate({ jobs, policy, jsaDone: doneSeven, cutoffDate: '2026-08-14' });
+  assert.equal(seven.percent, 70);
+  const a = complianceAssessment({ rate: seven, policy });
+  assert.equal(a.failed, true);
+  assert.equal(a.penaltyPoints, 2);
+  assert.match(a.note, /70% \(7 of 10 jobs complete\)/);
+  assert.match(a.note, /needed 80%/);
+
+  assert.equal(complianceRate({ jobs: [], policy, jsaDone: new Set() }), null);
+  assert.equal(complianceAssessment({ rate: null, policy }), null);   // qualifying period: no penalty
+});
+
+test('jobs before the cutoff or the window never count', () => {
+  const jobs = [job(1, '2026-08-10'), job(2, '2026-08-20'), job(3, '2026-05-01')];
+  const r = complianceRate({
+    jobs, policy, jsaDone: new Set(['u-2']),
+    cutoffDate: '2026-08-14', windowStart: '2026-06-01',
+  });
+  assert.equal(r.measured, 1);   // only job 2 — pre-cutoff and pre-window are out
+  assert.equal(r.percent, 100);
+});
+
+test('exactly 80% keeps the rate — the threshold is a floor, not a ceiling', () => {
+  const jobs = Array.from({ length: 10 }, (_, i) => job(i, '2026-08-20'));
+  const done8 = new Set(jobs.slice(0, 8).map((j) => j.uuid));
+  const r = complianceRate({ jobs, policy, jsaDone: done8, cutoffDate: '2026-08-14' });
+  assert.equal(complianceAssessment({ rate: r, policy }).failed, false);
+});
