new file mode 100644
index 0000000..f9108c4
--- /dev/null
+++ b/lib/compliance.mjs
@@ -0,0 +1,116 @@
+/**
+ * Compliance — 2 points of the rung hang on doing the paperwork.
+ *
+ * The deal (Steven, 8 Aug 2026): a job complies when every required item on
+ * it is done. A contractor keeps their rung rate when at least 80% of their
+ * jobs in the window comply; below that, the rate drops 2 points — 50 becomes
+ * 48. Assessed on the same 90-day rolling window as conversion, floored at
+ * the changeover so nobody is judged on jobs from before the rules existed.
+ *
+ * Two design rules carried over from the ladder:
+ *
+ *  - Store the RUNG and the FLAG, never a pre-baked 48. "Rung 0, compliance
+ *    failed" can answer what a stored 48 cannot: compliance recovers → back
+ *    to 50; they climb a rung while still failing → 58.
+ *  - A rate drop must arrive with its reason attached. An unexplained drop
+ *    is a dispute; an explained one is a conversation about paperwork.
+ *
+ * Version one measures the JSA only — it is a ServiceM8 form, so "done" is
+ * simply "a formresponse exists for this job", the same check Form 001 has
+ * always used. Photos and CCEW join later as tasks/attachments; the shape
+ * here (required set vs done set) already fits them.
+ *
+ * The 0-of-0 hole: a job with nothing required scores complete, so the
+ * required set must come from POLICY (every post-cutoff job requires a JSA),
+ * never from what happens to be attached to the job — otherwise the worst
+ * case reads as the best. requiredOn() is that policy, in one place.
+ */
+import { round2 } from './commission.mjs';
+
+export const DEFAULTS = { passPercent: 80, penaltyPoints: 2 };
+
+export const policyFor = (settings) => ({
+  ...DEFAULTS,
+  passPercent: Number(settings?.compliance?.passPercent) || DEFAULTS.passPercent,
+  penaltyPoints: Number(settings?.compliance?.penaltyPoints) || DEFAULTS.penaltyPoints,
+  jsaFormUuid: settings?.compliance?.jsaFormUuid || null,
+});
+
+/**
+ * Which jobs have a response for the given form, whatever ServiceM8 linked it
+ * by. Rows are matched tolerantly — a related-object uuid when present, and
+ * the "Job Number" answer as the fallback — because the two link styles both
+ * exist in the wild and a missed link must fail SAFE (job reads as not done,
+ * visibly, rather than silently passing).
+ */
+export function formDoneKeys(responses = [], formUuid) {
+  const done = new Set();
+  if (!formUuid) return done;
+  for (const r of responses) {
+    if (r.form_uuid !== formUuid) continue;
+    if (String(r.active) === '0') continue;
+    for (const k of [r.regarding_object_uuid, r.job_uuid, r.related_object_uuid]) {
+      if (k) done.add(String(k));
+    }
+    try {
+      const fields = JSON.parse(r.field_data || '[]');
+      const n = fields.find((f) => /job number/i.test(String(f.Question || '')));
+      if (n?.Response) done.add(String(n.Response).trim());
+    } catch { /* unreadable answers — the uuid keys above may still match */ }
+  }
+  return done;
+}
+
+/** Policy: what a post-cutoff job requires. Version one: a JSA, on every job. */
+export function requiredOn(job, policy) {
+  return policy.jsaFormUuid ? [{ key: 'jsa', label: 'JSA' }] : [];
+}
+
+/** One job: complies when every required item is done. */
+export function jobComplies(job, { policy, jsaDone }) {
+  const required = requiredOn(job, policy);
+  if (!required.length) return null; // nothing measurable — never counts either way
+  const done = required.every((item) =>
+    item.key !== 'jsa'
+    || jsaDone.has(String(job.uuid)) || jsaDone.has(String(job.jobNumber)));
+  return done;
+}
+
+/**
+ * The window: share of this contractor's post-cutoff jobs where everything
+ * required was done. Jobs before the window or the cutoff never count, and a
+ * period with nothing measurable returns null — unmeasured, not 0% and not
+ * 100%.
+ */
+export function complianceRate({ jobs = [], policy, jsaDone, windowStart, cutoffDate }) {
+  let measured = 0, passing = 0;
+  for (const job of jobs) {
+    if (!job.date) continue;
+    if (cutoffDate && job.date < cutoffDate) continue;
+    if (windowStart && job.date < windowStart) continue;
+    const ok = jobComplies(job, { policy, jsaDone });
+    if (ok === null) continue;
+    measured += 1;
+    if (ok) passing += 1;
+  }
+  if (!measured) return null;
+  return { measured, passing, percent: round2(passing / measured * 100) };
+}
+
+/**
+ * What the calculation needs: the flag, the points, and the sentence that
+ * explains the pay slip. Null when nothing is measurable — no penalty during
+ * the qualifying period, because you cannot fail a window that never ran.
+ */
+export function complianceAssessment({ rate, policy }) {
+  if (!rate) return null;
+  const failed = rate.percent < policy.passPercent;
+  return {
+    failed,
+    penaltyPoints: policy.penaltyPoints,
+    percent: rate.percent,
+    note: failed
+      ? `Compliance ran at ${rate.percent}% (${rate.passing} of ${rate.measured} jobs complete) — needed ${policy.passPercent}%, rate drops ${policy.penaltyPoints} points.`
+      : `Compliance at ${rate.percent}% (${rate.passing} of ${rate.measured} jobs) — rung rate holds.`,
+  };
+}
