+/**
+ * One docket, one claim.
+ *
+ * Run: node --test test/receipt-dupes.test.mjs
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  DEFAULT_DUPLICATE_POLICY, policyFor, docketKey, docketTotalOf, checkDocket, docketFlags,
+} from '../lib/receipt-dupes.mjs';
+
+const docket = (over = {}) => ({
+  id: 'RCPT-1', jobNumber: '167595', contractorId: 'c1',
+  supplier: 'AGM Electrical Supplies', invoiceNumber: 'IN688575',
+  amountIncGst: 130.17, date: '2026-08-05', docketTotalIncGst: 130.17, ...over,
+});
+
+test('the same paper makes the same key however it is written', () => {
+  const a = docketKey(docket());
+  assert.equal(docketKey(docket({ supplier: 'AGM ELECTRICAL SUPPLIES PTY LTD' })), a);
+  assert.equal(docketKey(docket({ invoiceNumber: 'in 688575' })), a);
+  assert.equal(docketKey(docket({ invoiceNumber: 'IN-688575' })), a);
+  // A different invoice from the same supplier is a different docket.
+  assert.notEqual(docketKey(docket({ invoiceNumber: 'IN688576' })), a);
+});
+
+test('no invoice number: supplier, date and amount stand in', () => {
+  const k = docketKey(docket({ invoiceNumber: null }));
+  assert.ok(k.includes('D:2026-08-05'));
+  assert.equal(docketKey(docket({ invoiceNumber: null, amountIncGst: 130.18 })) === k, false);
+});
+
+test('unidentifiable receipts are not guessed at', () => {
+  assert.equal(docketKey({ supplier: null, amountIncGst: 50, date: '2026-08-05' }), null);
+  assert.equal(docketKey({ supplier: 'AGM', invoiceNumber: null, date: null, amountIncGst: 50 }), null);
+  assert.equal(docketKey(null), null);
+});
+
+test('a first receipt always saves', () => {
+  const r = checkDocket({ existing: [], incoming: docket() });
+  assert.equal(r.verdict, 'ok');
+  assert.equal(r.reuse, false);
+});
+
+test('the same docket on the same job is blocked', () => {
+  const r = checkDocket({ existing: [docket()], incoming: docket({ id: 'RCPT-2' }) });
+  assert.equal(r.verdict, 'blocked');
+  assert.equal(r.reason, 'sameJob');
+  assert.match(r.message, /already on job #167595/);
+});
+
+test('a receipt never blocks against itself — an edit is not a duplicate', () => {
+  const r = checkDocket({ existing: [docket()], incoming: docket() });
+  assert.equal(r.verdict, 'ok');
+});
+
+test('one docket split across two jobs is allowed, and says so', () => {
+  const first = docket({ id: 'RCPT-1', jobNumber: '167595', amountIncGst: 80, docketTotalIncGst: 130.17 });
+  const r = checkDocket({
+    existing: [first],
+    incoming: docket({ id: 'RCPT-2', jobNumber: '167610', amountIncGst: 50.17 }),
+  });
+  assert.equal(r.verdict, 'ok');
+  assert.equal(r.reuse, true);
+  assert.equal(r.remainingIncGst, 0);
+  assert.match(r.message, /Split from a docket already used on job #167595/);
+});
+
+test('a split may not claim more than the paper says', () => {
+  const first = docket({ id: 'RCPT-1', jobNumber: '167595', amountIncGst: 80 });
+  const r = checkDocket({
+    existing: [first],
+    incoming: docket({ id: 'RCPT-2', jobNumber: '167610', amountIncGst: 90 }),
+  });
+  assert.equal(r.verdict, 'blocked');
+  assert.equal(r.reason, 'overDocket');
+  assert.equal(r.remainingIncGst, 50.17);
+  assert.match(r.message, /\$50\.17 left on it/);
+});
+
+test('a fully claimed docket says so rather than quoting nothing left', () => {
+  const first = docket({ id: 'RCPT-1', amountIncGst: 130.17 });
+  const r = checkDocket({
+    existing: [first], incoming: docket({ id: 'RCPT-2', jobNumber: '167610', amountIncGst: 10 }),
+  });
+  assert.equal(r.reason, 'overDocket');
+  assert.match(r.message, /fully claimed already/);
+});
+
+test('cents of rounding do not block a legitimate split', () => {
+  const first = docket({ id: 'RCPT-1', amountIncGst: 65.08, docketTotalIncGst: 130.17 });
+  const r = checkDocket({
+    existing: [first], incoming: docket({ id: 'RCPT-2', jobNumber: '167610', amountIncGst: 65.09 }),
+  });
+  assert.equal(r.verdict, 'ok');
+});
+
+test('the human correcting an under-read total is believed over the OCR', () => {
+  // The reader said 130.17 and the human corrected it to 140 on the first
+  // entry: the docket total follows the largest figure recorded.
+  assert.equal(docketTotalOf([{ docketTotalIncGst: 130.17 }, { docketTotalIncGst: 140 }]), 140);
+  assert.equal(docketTotalOf([{ amountIncGst: 99 }]), null);
+});
+
+test('with no docket total there is no cap, but the reuse is still reported', () => {
+  const first = docket({ id: 'RCPT-1', docketTotalIncGst: null, amountIncGst: 80 });
+  const r = checkDocket({
+    existing: [first],
+    incoming: docket({ id: 'RCPT-2', jobNumber: '167610', amountIncGst: 900, docketTotalIncGst: null }),
+  });
+  assert.equal(r.verdict, 'ok');
+  assert.equal(r.uncapped, true);
+  assert.equal(r.reuse, true);
+});
+
+test('policy comes from settings, and the defaults are only a fallback', () => {
+  assert.equal(policyFor(null).blockSameJob, true);
+  assert.equal(policyFor({ receipts: { duplicates: { blockSameJob: false } } }).blockSameJob, false);
+  // Turning the same-job block off does NOT open the door: the docket total
+  // catches it anyway, because claiming $130.17 twice off a $130.17 docket is
+  // over-claiming however it is spelled. Two independent lines, on purpose.
+  const off = { ...DEFAULT_DUPLICATE_POLICY, blockSameJob: false };
+  const r = checkDocket({ existing: [docket()], incoming: docket({ id: 'RCPT-2' }), policy: off });
+  assert.equal(r.verdict, 'blocked');
+  assert.equal(r.reason, 'overDocket');
+});
+
+/* ---------- the owner's report ---------- */
+
+test('the same docket under two contractors is the flag that leads', () => {
+  const flags = docketFlags({
+    c1: [docket({ id: 'A', contractorId: 'c1' })],
+    c2: [docket({ id: 'B', contractorId: 'c2', jobNumber: '167610' })],
+  }, (id) => ({ c1: 'Charlie', c2: 'Sam' })[id]);
+  assert.equal(flags.crossContractor.length, 1);
+  assert.equal(flags.reused.length, 0);
+  const f = flags.crossContractor[0];
+  assert.deepEqual(f.entries.map((e) => e.contractor), ['Charlie', 'Sam']);
+  assert.equal(f.claimedIncGst, 260.34);
+  assert.equal(f.overClaimed, true);
+});
+
+test('one contractor reusing their own docket is reported separately', () => {
+  const flags = docketFlags({
+    c1: [
+      docket({ id: 'A', amountIncGst: 80 }),
+      docket({ id: 'B', jobNumber: '167610', amountIncGst: 50.17 }),
+    ],
+  });
+  assert.equal(flags.crossContractor.length, 0);
+  assert.equal(flags.reused.length, 1);
+  // A legitimate split adds up, so it is visible without being an accusation.
+  assert.equal(flags.reused[0].overClaimed, false);
+});
+
+test('a docket used once is not a flag', () => {
+  const flags = docketFlags({ c1: [docket()], c2: [docket({ id: 'B', invoiceNumber: 'IN999' })] });
+  assert.equal(flags.crossContractor.length, 0);
+  assert.equal(flags.reused.length, 0);
+});
+
+test('over-claimed dockets sort above merely reused ones', () => {
+  const flags = docketFlags({
+    c1: [
+      docket({ id: 'A', invoiceNumber: 'IN1', amountIncGst: 50, docketTotalIncGst: 100 }),
+      docket({ id: 'B', invoiceNumber: 'IN1', jobNumber: '2', amountIncGst: 50, docketTotalIncGst: 100 }),
+      docket({ id: 'C', invoiceNumber: 'IN2', amountIncGst: 20, docketTotalIncGst: 20 }),
+      docket({ id: 'D', invoiceNumber: 'IN2', jobNumber: '2', amountIncGst: 20, docketTotalIncGst: 20 }),
+    ],
+  });
+  assert.equal(flags.reused[0].invoiceNumber, 'IN2');
+  assert.equal(flags.reused[0].overClaimed, true);
+});
