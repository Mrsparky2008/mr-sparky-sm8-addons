+++ b/test/settings-coverage.test.mjs
@@ -14,6 +14,7 @@ import { loadSettings, gstDivisor, contractorById, contractorFor } from '../lib/
 import { DEFAULT_LADDER, ladderFor } from '../lib/ladder.mjs';
 import { DEFAULTS as RETENTION_DEFAULTS, policyFor } from '../lib/retention.mjs';
 import { DEFAULT_POLICY as WARRANTY_DEFAULTS, policy as warrantyPolicy } from '../lib/warranty.mjs';
+import { DEFAULT_DUPLICATE_POLICY, policyFor as duplicatePolicyFor } from '../lib/receipt-dupes.mjs';
 
