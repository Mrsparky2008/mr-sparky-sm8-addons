diff --git a/lib/receipt-dupes.mjs b/lib/receipt-dupes.mjs
new file mode 100644
index 0000000..d05f2e1
--- /dev/null
+++ b/lib/receipt-dupes.mjs
@@ -0,0 +1,200 @@
+/**
+ * One docket, one claim.
+ *
+ * The gap Steven found (2026-08-06): nothing stopped the same piece of paper
+ * being filed on job A, then job B, then job A again — and every one of them
+ * would be reimbursed. The receipt loop was built to make evidence easy to
+ * capture; this is the half that makes it hard to capture twice.
+ *
+ * A docket's identity is the supplier plus the invoice number. That is why the
+ * supplier list exists at all: AGM, AGM ELECTRICAL SUPPLIES PTY LTD and "agm
+ * electrical" have to be one supplier or this check leaks. Where a docket
+ * carries no invoice number, supplier + date + amount stands in — weaker, but
+ * better than nothing.
+ *
+ * The image itself is deliberately NOT part of the identity. Photograph the
+ * same docket twice and every byte differs, so hashing would only catch
+ * re-uploading the identical file, which is the one case nobody does.
+ *
+ * Three cases, three different answers, all Steven's calls:
+ *
+ *   Same docket, same job        BLOCKED. Almost always an honest double-tap,
+ *                                so it says so plainly.
+ *   Same docket, different job,  ALLOWED — buying for two jobs on one run is
+ *   same contractor              normal — but the amounts across those jobs
+ *                                may not exceed what the paper says, and every
+ *                                reuse stays visible to the office.
+ *   Same docket, two contractors SILENT. The second person's save behaves
+ *                                completely normally. The owner is told; they
+ *                                are not. If two people are coordinating, the
+ *                                worst thing the system can do is announce
+ *                                that it noticed.
+ *
+ * That last rule is why the cross-contractor check lives in the owner's
+ * report and NOT in the save path: it cannot refuse anything, so it cannot
+ * leak anything. Silence by construction, not by remembering to be quiet.
+ */
+import { round2 } from './commission.mjs';
+import { normalise } from './suppliers.mjs';
+
+export const DEFAULT_DUPLICATE_POLICY = {
+  // Same docket, same job. Off only if a job ever legitimately needs the same
+  // invoice twice, which nobody has been able to describe.
+  blockSameJob: true,
+  // Splitting one docket across jobs may not claim more than the docket says.
+  capToDocketTotal: true,
+  // Cents of slack for rounding when a docket is split. Not a fudge factor for
+  // a genuinely different amount.
+  centsTolerance: 0.02,
+};
+
+export function policyFor(settings) {
+  return { ...DEFAULT_DUPLICATE_POLICY, ...(settings?.receipts?.duplicates || {}) };
+}
+
+/**
+ * What makes this piece of paper this piece of paper. Null when there is not
+ * enough to identify it — a Form 001 expense with no supplier can't be matched
+ * against anything, and guessing would be worse than not checking.
+ */
+export function docketKey(r) {
+  const supplier = normalise(r?.supplier);
+  if (!supplier) return null;
+  const invoice = String(r?.invoiceNumber || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
+  if (invoice) return `S:${supplier}|I:${invoice}`;
+  // No invoice number on the paper: the amount and the day stand in for it.
+  const amount = Number(r?.amountIncGst);
+  if (!r?.date || !Number.isFinite(amount)) return null;
+  return `S:${supplier}|D:${String(r.date).slice(0, 10)}|A:${round2(amount).toFixed(2)}`;
+}
+
+/**
+ * What the paper says the whole docket came to, as opposed to what is being
+ * claimed against this one job. Normally the same number; on a split they
+ * differ, and the difference is the entire point.
+ *
+ * Takes the largest recorded across every entry for the docket. That is not
+ * generosity: the reader can under-read a total, and the human who corrects it
+ * upward on the first entry is the better authority than the OCR was.
+ */
+export function docketTotalOf(rows) {
+  let best = 0;
+  for (const r of rows) {
+    const t = Number(r?.docketTotalIncGst);
+    if (Number.isFinite(t) && t > best) best = t;
+  }
+  return best > 0 ? round2(best) : null;
+}
+
+/**
+ * May this receipt be filed?
+ *
+ * `existing` is THIS contractor's own receipts — every job, not just the one
+ * being filed against. Cross-contractor collisions are not consulted here on
+ * purpose; see the note at the top.
+ */
+export function checkDocket({ existing = [], incoming, policy = DEFAULT_DUPLICATE_POLICY }) {
+  const key = docketKey(incoming);
+  // Not identifiable, so not checkable. It saves, as it always did.
+  if (!key) return { verdict: 'ok', key: null, matches: [], reuse: false };
+
+  const matches = existing.filter((r) => r && r.id !== incoming.id && docketKey(r) === key);
+  if (!matches.length) return { verdict: 'ok', key, matches: [], reuse: false };
+
+  const seen = matches.map((r) => ({
+    id: r.id, jobNumber: String(r.jobNumber), amountIncGst: round2(Number(r.amountIncGst) || 0), date: r.date,
+  }));
+
+  const sameJob = seen.filter((r) => r.jobNumber === String(incoming.jobNumber));
+  if (sameJob.length && policy.blockSameJob) {
+    return {
+      verdict: 'blocked', reason: 'sameJob', key, matches: seen, reuse: true,
+      message: `This docket is already on job #${incoming.jobNumber}`
+        + `${matches[0].supplier ? ` — ${matches[0].supplier}` : ''}`
+        + `${incoming.invoiceNumber ? ` invoice ${incoming.invoiceNumber}` : ''}`
+        + `, $${sameJob[0].amountIncGst.toFixed(2)}. Filing it twice would claim it twice.`,
+    };
+  }
+
+  const total = docketTotalOf([...matches, incoming]);
+  const claimed = round2(seen.reduce((sum, r) => sum + r.amountIncGst, 0));
+  const amount = round2(Number(incoming.amountIncGst) || 0);
+
+  if (policy.capToDocketTotal && total) {
+    const remaining = round2(total - claimed);
+    if (amount > remaining + policy.centsTolerance) {
+      return {
+        verdict: 'blocked', reason: 'overDocket', key, matches: seen, reuse: true,
+        docketTotalIncGst: total, remainingIncGst: remaining,
+        message: remaining <= 0
+          ? `This docket is fully claimed already — $${total.toFixed(2)} across `
+            + `job${seen.length > 1 ? 's' : ''} ${seen.map((r) => `#${r.jobNumber}`).join(', ')}.`
+          : `This docket has $${remaining.toFixed(2)} left on it. `
+            + `$${claimed.toFixed(2)} of $${total.toFixed(2)} is already claimed on `
+            + `job${seen.length > 1 ? 's' : ''} ${seen.map((r) => `#${r.jobNumber}`).join(', ')}.`,
+      };
+    }
+    return {
+      verdict: 'ok', key, matches: seen, reuse: true,
+      docketTotalIncGst: total, remainingIncGst: round2(remaining - amount),
+      message: `Split from a docket already used on job${seen.length > 1 ? 's' : ''} `
+        + `${seen.map((r) => `#${r.jobNumber}`).join(', ')}.`,
+    };
+  }
+
+  // Reused, but there is no docket total to measure it against — a hand-typed
+  // receipt from before the reader existed. Recorded and visible, not refused.
+  return {
+    verdict: 'ok', key, matches: seen, reuse: true, uncapped: true,
+    message: `This docket is already on job${seen.length > 1 ? 's' : ''} `
+      + `${seen.map((r) => `#${r.jobNumber}`).join(', ')}.`,
+  };
+}
+
+/**
+ * The owner's view: every docket that appears more than once, anywhere.
+ *
+ * Split in two because they mean completely different things. A contractor
+ * reusing their own docket across two jobs is usually a split purchase and
+ * needs no action — it is here so a PATTERN is visible. The same docket under
+ * two different contractors is not explainable by a split, and is the one the
+ * report leads with.
+ *
+ * `receiptsByContractor` is { contractorId: [receipt, ...] }.
+ */
+export function docketFlags(receiptsByContractor = {}, nameOf = (id) => id) {
+  const byKey = new Map();
+  for (const [contractorId, rows] of Object.entries(receiptsByContractor)) {
+    for (const r of rows || []) {
+      const key = docketKey(r);
+      if (!key) continue;
+      if (!byKey.has(key)) byKey.set(key, []);
+      byKey.get(key).push({ ...r, contractorId });
+    }
+  }
+
+  const crossContractor = [], reused = [];
+  for (const [key, rows] of byKey) {
+    if (rows.length < 2) continue;
+    const entry = {
+      key,
+      supplier: rows[0].supplier || null,
+      invoiceNumber: rows[0].invoiceNumber || null,
+      docketTotalIncGst: docketTotalOf(rows),
+      claimedIncGst: round2(rows.reduce((s, r) => s + (Number(r.amountIncGst) || 0), 0)),
+      entries: rows.map((r) => ({
+        contractorId: r.contractorId, contractor: nameOf(r.contractorId),
+        jobNumber: String(r.jobNumber), amountIncGst: round2(Number(r.amountIncGst) || 0),
+        date: r.date, addedAt: r.addedAt || null, id: r.id,
+      })).sort((a, b) => String(a.addedAt || '').localeCompare(String(b.addedAt || ''))),
+    };
+    entry.overClaimed = !!(entry.docketTotalIncGst
+      && entry.claimedIncGst > entry.docketTotalIncGst + DEFAULT_DUPLICATE_POLICY.centsTolerance);
+    const owners = new Set(rows.map((r) => r.contractorId));
+    (owners.size > 1 ? crossContractor : reused).push(entry);
+  }
+
+  // Worst first: over-claimed before merely reused, then by the money at stake.
+  const worst = (a, b) => (Number(b.overClaimed) - Number(a.overClaimed)) || (b.claimedIncGst - a.claimedIncGst);
+  return { crossContractor: crossContractor.sort(worst), reused: reused.sort(worst) };
+}
