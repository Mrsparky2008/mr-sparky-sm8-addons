diff --git a/test/suppliers.test.mjs b/test/suppliers.test.mjs
new file mode 100644
index 0000000..a5c8b62
--- /dev/null
+++ b/test/suppliers.test.mjs
@@ -0,0 +1,59 @@
+/**
+ * The suppliers list, and matching a docket's printed name to it.
+ *
+ * Run: node --test test/suppliers.test.mjs
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  DEFAULT_SUPPLIERS, suppliersFor, matchSupplier, normalise, slug,
+} from '../lib/suppliers.mjs';
+
+const list = suppliersFor(null);
+
+test('the seed stands in when settings carry no list', () => {
+  assert.equal(suppliersFor(null).length, DEFAULT_SUPPLIERS.length);
+  assert.equal(suppliersFor({}).length, DEFAULT_SUPPLIERS.length);
+  assert.equal(suppliersFor({ suppliers: [] }).length, DEFAULT_SUPPLIERS.length);
+});
+
+test('a settings list wins outright — the seed never merges into it', () => {
+  const own = suppliersFor({ suppliers: [{ name: 'Sparky Supplies' }] });
+  assert.equal(own.length, 1);
+  assert.equal(own[0].name, 'Sparky Supplies');
+  assert.equal(own[0].id, 'sparkysupplies');
+  assert.deepEqual(own[0].aliases, []);
+});
+
+test('a nameless row is dropped rather than served as a blank chip', () => {
+  const own = suppliersFor({ suppliers: [{ name: 'Real' }, { name: '  ' }, null] });
+  assert.deepEqual(own.map((s) => s.name), ['Real']);
+});
+
+test('the docket name is not the trade name — aliases carry the gap', () => {
+  assert.equal(matchSupplier(list, 'MIDDENDORP ELECTRIC CO PTY LTD').id, 'middys');
+  assert.equal(matchSupplier(list, 'LAWRENCE & HANSON GROUP PTY LTD').id, 'lh');
+  assert.equal(matchSupplier(list, 'L&H Marrickville').id, 'lh');
+  assert.equal(matchSupplier(list, 'MMEM ALEXANDRIA').id, 'mmem');
+  assert.equal(matchSupplier(list, 'Bunnings Warehouse Ashfield').id, 'bunnings');
+});
+
+test('an unknown supplier stays unknown — no nearest guess', () => {
+  assert.equal(matchSupplier(list, 'Joe Blow Electrical Wholesale'), null);
+  assert.equal(matchSupplier(list, ''), null);
+  assert.equal(matchSupplier(list, null), null);
+  assert.equal(matchSupplier([], 'Middy\'s'), null);
+});
+
+test('the longest match wins, so a shared word cannot steal it', () => {
+  const two = suppliersFor({ suppliers: [
+    { name: 'Hanson' }, { name: 'Lawrence & Hanson' },
+  ] });
+  assert.equal(matchSupplier(two, 'LAWRENCE & HANSON PTY LTD').name, 'Lawrence & Hanson');
+});
+
+test('normalise drops what identifies nobody', () => {
+  assert.equal(normalise('MIDDENDORP ELECTRIC CO PTY LTD'), 'middendorp electric');
+  assert.equal(normalise("Middy's"), 'middy s');
+  assert.equal(slug('Lawrence & Hanson'), 'lawrencehanson');
+});
