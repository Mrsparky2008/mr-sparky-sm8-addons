+/**
+ * The suppliers list.
+ *
+ * Steven's ask (2026-08-06): "a section in settings to add common suppliers to
+ * select from ... if not in list select other and open a field to type the
+ * supplier name. It will serve as dial purposes later."
+ *
+ * Two jobs, one list. On the phone it turns a supplier field into a row of
+ * chips, so the same wholesaler is spelled the same way every time — which is
+ * what lets receipts group and reconcile at all. Later it holds the phone
+ * number, so the same list dials.
+ *
+ * The matching half exists because a docket never prints the name anyone
+ * says out loud. The paper says MIDDENDORP ELECTRIC CO PTY LTD; the trade
+ * says Middy's. Aliases carry that, so a receipt read off a photo lands on
+ * the right chip instead of creating a fourteenth spelling.
+ *
+ * Nothing here decides money. It normalises a name, and that is all.
+ */
+
+/**
+ * The starter list — electrical wholesalers an Australian sparky actually
+ * stands at. It is a SEED, not the truth: the office edits the live list in
+ * portal settings, and phone numbers are deliberately blank rather than
+ * guessed, because a wrong number that dials is worse than an empty field.
+ */
+export const DEFAULT_SUPPLIERS = [
+  { id: 'middys', name: "Middy's", phone: '', aliases: ['Middendorp', 'Middendorp Electric'] },
+  { id: 'lh', name: 'Lawrence & Hanson', phone: '', aliases: ['L&H', 'Lawrence and Hanson'] },
+  { id: 'mmem', name: 'MM Electrical', phone: '', aliases: ['MMEM', 'MM Electrical Merchandising'] },
+  { id: 'rexel', name: 'Rexel', phone: '', aliases: ['Ideal Electrical', 'Rexel Electrical'] },
+  { id: 'agm', name: 'AGM Electrical Supplies', phone: '', aliases: ['AGM', 'AGM Electrical'] },
+  { id: 'auslec', name: 'Auslec', phone: '', aliases: [] },
+  { id: 'cnw', name: 'CNW', phone: '', aliases: ['CNW Electrical'] },
+  { id: 'haymans', name: 'Haymans', phone: '', aliases: ['Haymans Electrical'] },
+  { id: 'bunnings', name: 'Bunnings', phone: '', aliases: ['Bunnings Warehouse'] },
+];
+
+/**
+ * The live list. Settings win when they carry one; the seed stands in when
+ * they do not — which is the normal case for a while, because the stored
+ * settings in DynamoDB predate this key and a deploy never overwrites them.
+ */
+export function suppliersFor(settings) {
+  const list = Array.isArray(settings?.suppliers) && settings.suppliers.length
+    ? settings.suppliers
+    : DEFAULT_SUPPLIERS;
+  return list
+    .filter((s) => s && String(s.name || '').trim())
+    .map((s, i) => ({
+      id: String(s.id || slug(s.name) || `s${i}`),
+      name: String(s.name).trim(),
+      phone: String(s.phone || '').trim(),
+      aliases: (Array.isArray(s.aliases) ? s.aliases : []).map((a) => String(a).trim()).filter(Boolean),
+    }));
+}
+
+export function slug(name) {
+  return String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '').slice(0, 24);
+}
+
+/**
+ * Down to the letters that identify a business. Company suffixes go, because
+ * "PTY LTD" is on every docket and identifies nobody; punctuation goes,
+ * because an apostrophe is a coin toss (Middys, Middy's, MIDDYS).
+ */
+export function normalise(text) {
+  return String(text || '')
+    .toLowerCase()
+    .replace(/\b(pty|ltd|limited|inc|incorporated|group|australia|au|co|company|the)\b/g, ' ')
+    .replace(/[^a-z0-9]+/g, ' ')
+    .trim();
+}
+
+/**
+ * Which supplier a piece of text is, or null. Deliberately conservative: it
+ * matches on a whole name or alias appearing in the text (or the text in the
+ * name), never on a fuzzy distance. A wrong confident match would put one
+ * wholesaler's spend under another's name, and nobody would ever notice.
+ */
+export function matchSupplier(suppliers, text) {
+  const hay = normalise(text);
+  if (!hay) return null;
+  let best = null;
+  for (const s of suppliers || []) {
+    for (const candidate of [s.name, ...(s.aliases || [])]) {
+      const needle = normalise(candidate);
+      // Two letters is not evidence — "co" or "au" would match half the page.
+      if (needle.length < 3) continue;
+      if (hay.includes(needle) || (hay.length >= 3 && needle.includes(hay))) {
+        // The longest match wins: "Lawrence & Hanson" beats a bare "Hanson".
+        if (!best || needle.length > best.length) best = { supplier: s, length: needle.length };
+      }
+    }
+  }
+  return best ? best.supplier : null;
+}
