+/**
+ * ", filed 5 Aug from this app" — the fact that ends most of these on the spot.
+ * Empty when nothing was recorded, rather than inventing a date.
+ */
+function filedWhen(row) {
+  const stamp = String(row?.addedAt || '').slice(0, 10);
+  if (!stamp) return '';
+  const d = new Date(`${stamp}T12:00:00`);
+  if (Number.isNaN(d.getTime())) return '';
+  const when = d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
+  const how = row.source === 'office' ? ' by the office'
+    : row.source === 'form001' ? ' on the Form 001' : '';
+  return `, filed ${when}${how}`;
+}
+
