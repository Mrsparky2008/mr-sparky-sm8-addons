diff --git a/test/claimable.test.mjs b/test/claimable.test.mjs
new file mode 100644
index 0000000..65276fb
--- /dev/null
+++ b/test/claimable.test.mjs
@@ -0,0 +1,82 @@
+/**
+ * What can be claimed right now.
+ *
+ * These exist because the browser used to answer this question for itself and
+ * got a different answer to the list it was sitting above. The native app is a
+ * second client asking the same question, so the answer has to come from one
+ * place and the selection and the total have to agree by construction.
+ *
+ * Run: node --test test/claimable.test.mjs
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { claimableNow } from '../lib/claims.mjs';
+
+const job = (jobNumber, payableIncGst, outcome = 'OK') => ({ jobNumber, payableIncGst, outcome });
+
+test('sums only the jobs it also lists', () => {
+  const c = claimableNow({ jobs: [job('101', 100), job('102', 250.5)] });
+  assert.deepEqual(c.jobNumbers, ['101', '102']);
+  assert.equal(c.jobCount, 2);
+  assert.equal(c.jobsIncGst, 350.5);
+  assert.equal(c.totalIncGst, 350.5);
+});
+
+test('a job already on a claim is neither listed nor counted', () => {
+  const c = claimableNow({
+    jobs: [job('101', 100), job('102', 250)],
+    claimed: ['102'],
+  });
+  assert.deepEqual(c.jobNumbers, ['101']);
+  assert.equal(c.totalIncGst, 100);
+});
+
+test('a job that cannot be paid yet is neither listed nor counted', () => {
+  const c = claimableNow({
+    jobs: [job('101', 100), job('102', 250, 'AWAITING_FORM')],
+  });
+  assert.deepEqual(c.jobNumbers, ['101']);
+  assert.equal(c.totalIncGst, 100);
+});
+
+test('helping-hand lines are claimed separately from the job of the same number', () => {
+  // A contractor can help on a job that is not theirs, so 'H101' and '101' are
+  // different things and claiming one must not hide the other.
+  const c = claimableNow({
+    jobs: [job('101', 100)],
+    helperEarnings: [{ jobNumber: '101', amountIncGst: 60 }],
+  });
+  assert.deepEqual(c.jobNumbers, ['101']);
+  assert.deepEqual(c.helperJobNumbers, ['101']);
+  assert.equal(c.helpingIncGst, 60);
+  assert.equal(c.totalIncGst, 160);
+
+  const helped = claimableNow({
+    jobs: [job('101', 100)],
+    helperEarnings: [{ jobNumber: '101', amountIncGst: 60 }],
+    claimed: ['H101'],
+  });
+  assert.deepEqual(helped.jobNumbers, ['101']);
+  assert.deepEqual(helped.helperJobNumbers, []);
+  assert.equal(helped.totalIncGst, 100);
+});
+
+test('GST is split out of the total, not added to it', () => {
+  const c = claimableNow({ jobs: [job('101', 1100)] });
+  assert.equal(c.totalIncGst, 1100);
+  assert.equal(c.totalExGst, 1000);
+  assert.equal(c.gstAmount, 100);
+});
+
+test('nothing to claim is zero, not a crash', () => {
+  const c = claimableNow();
+  assert.deepEqual(c.jobNumbers, []);
+  assert.equal(c.jobCount, 0);
+  assert.equal(c.totalIncGst, 0);
+  assert.equal(c.gstAmount, 0);
+});
+
+test('rounds once at the total rather than accumulating cent drift', () => {
+  const c = claimableNow({ jobs: [job('1', 0.105), job('2', 0.105)] });
+  assert.equal(c.jobsIncGst, 0.21);
+});
