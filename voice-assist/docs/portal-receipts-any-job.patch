+/**
+ * What can be claimed right now, and what it comes to.
+ *
+ * This used to be worked out in the browser, and the tile it fed once disagreed
+ * with the list underneath it by tens of thousands of dollars, because the two
+ * applied "already claimed" differently. Any client that works this out for
+ * itself can drift the same way — and the native app is a second client. So it
+ * is worked out here, once, beside the rules it depends on, and both faces are
+ * handed the same answer.
+ *
+ * The selection and the total have to come out of the same pass. That was the bug.
+ */
+export function claimableNow({
+  jobs = [], helperEarnings = [], claimed = [], gstDivisor = 1.1,
+} = {}) {
+  const spokenFor = new Set(claimed);
+  const okJobs = jobs.filter((j) => j.outcome === 'OK' && !spokenFor.has(j.jobNumber));
+  const help = helperEarnings.filter((l) => !spokenFor.has(`H${l.jobNumber}`));
+
+  const jobsIncGst = round2(okJobs.reduce((a, j) => a + j.payableIncGst, 0));
+  const helpingIncGst = round2(help.reduce((a, l) => a + l.amountIncGst, 0));
+  const totalIncGst = round2(jobsIncGst + helpingIncGst);
+
+  return {
+    jobNumbers: okJobs.map((j) => j.jobNumber),
+    helperJobNumbers: help.map((l) => l.jobNumber),
+    jobCount: okJobs.length,
+    jobsIncGst,
+    helpingIncGst,
+    totalIncGst,
+    totalExGst: round2(totalIncGst / gstDivisor),
+    gstAmount: round2(totalIncGst - totalIncGst / gstDivisor),
+  };
+}
