@@ -141,6 +141,61 @@ export async function receiptsForJob(contractorId, jobNumber) {
   return queryPrefix(contractorId, `RCPT#${jobNumber}#`);
 }
 
+/**
+ * Void a receipt, or bring it back. Never deletes — the row stays with its
+ * photo and its history, marked, so "this should not have existed" is itself
+ * on the record. Voided receipts are excluded from reimbursement and from the
+ * duplicate check, so a mis-keyed entry can be corrected rather than blocking
+ * the right one for ever.
+ */
+export async function setReceiptVoided(contractorId, jobNumber, receiptId, voided, by, reason) {
+  const { UpdateCommand } = await import('@aws-sdk/lib-dynamodb');
+  const r = await (await doc()).send(new UpdateCommand({
+    TableName: TABLE,
+    Key: { pk: pk(contractorId), sk: `RCPT#${jobNumber}#${receiptId}` },
+    UpdateExpression: 'SET voided = :v, voidedBy = :b, voidedAt = :t, voidedReason = :r',
+    ExpressionAttributeValues: {
+      ':v': !!voided, ':b': by || null,
+      ':t': new Date().toISOString(), ':r': reason || null,
+    },
+    ConditionExpression: 'attribute_exists(sk)',
+    ReturnValues: 'ALL_NEW',
+  }));
+  return r.Attributes;
+}
+
+/**
+ * Move a receipt to a different job.
+ *
+ * The job number is part of the sort key, so this is a rewrite rather than an
+ * update: written to the new key FIRST, then removed from the old. That order
+ * is deliberate. A failure between the two leaves the receipt on both jobs —
+ * visible, and caught by the duplicate report — whereas delete-first would
+ * lose it along with its photo if the write failed.
+ *
+ * The id never changes, so the S3 photo key still resolves and the audit trail
+ * survives the move.
+ */
+export async function moveReceipt(contractorId, fromJobNumber, receiptId, toJobNumber, by) {
+  const { GetCommand, PutCommand, DeleteCommand } = await import('@aws-sdk/lib-dynamodb');
+  const d = await doc();
+  const from = `RCPT#${fromJobNumber}#${receiptId}`;
+  const got = await d.send(new GetCommand({ TableName: TABLE, Key: { pk: pk(contractorId), sk: from } }));
+  if (!got.Item) throw new Error('That receipt is no longer there');
+
+  const moved = {
+    ...got.Item,
+    sk: `RCPT#${toJobNumber}#${receiptId}`,
+    jobNumber: String(toJobNumber),
+    movedFrom: String(fromJobNumber),
+    movedBy: by || null,
+    movedAt: new Date().toISOString(),
+  };
+  await d.send(new PutCommand({ TableName: TABLE, Item: moved }));
+  await d.send(new DeleteCommand({ TableName: TABLE, Key: { pk: pk(contractorId), sk: from } }));
+  return moved;
+}
+
