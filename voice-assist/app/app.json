{
  "expo": {
    "name": "Mr Sparky",
    "slug": "mr-sparky-ai-assistant",
    "owner": "mr_sparky",
    "version": "2.4.0",
    "scheme": "mrsparky-aiassist",
    "extra": {
      "eas": {
        "projectId": "d31c0122-3886-4d57-8388-ec1bfd817f9f"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1b2d",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1b2d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.com.mrsparky.aiassist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Mr Sparky can attach photos from your library to job cards.",
        "NSPhotoLibraryAddUsageDescription": "Mr Sparky can save job photos to your library.",
        "NSCameraUsageDescription": "Mr Sparky can take photos to attach to job cards.",
        "NSFaceIDUsageDescription": "Face ID unlocks Mr Sparky so you only sign in once on this phone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "au.com.mrsparky.aiassist",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1b2d"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mr Sparky uses the camera to photograph receipts and job photos.",
          "photosPermission": "Mr Sparky can attach photos from your library to receipts and job cards."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d31c0122-3886-4d57-8388-ec1bfd817f9f"
    }
  }
}
